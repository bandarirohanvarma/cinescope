# Copy to .env and fill in. Never commit .env.

# Local services from docker-compose.yml
DATABASE_URL=postgresql+asyncpg://cinescope:cinescope@localhost:5433/cinescope
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Phase 1: https://www.themoviedb.org/settings/api (use the "API Read Access Token")
TMDB_API_KEY=
TMDB_REGION=IN
TMDB_LANGUAGES=["te","hi"]

# Phase 6: https://console.groq.com/keys
GROQ_API_KEY=

# Frontend (server-side) -> backend URL
API_URL=http://localhost:8000
